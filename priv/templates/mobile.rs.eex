// Generated by `mix ex_tauri.ios init` (ex_tauri:mobile-shell); rerunning it
// regenerates this file. The desktop app starts in main.rs; this is the iOS app.
//
// iOS lets an app start no other process, and a device maps no executable
// memory, so the backend runs inside this app: ERTS, linked in by build.rs from
// the liberlang.xcframework that `mix ex_tauri.ios run|device` stages (built by
// `ampoule pack --target ios`), boots the bundled release on a thread of its
// own. The same build runs in the simulator and on an iPhone or iPad.
#[cfg(mobile)]
mod mobile {
    use std::fmt::Write;
    use std::sync::atomic::AtomicBool;
    use std::sync::OnceLock;
    use std::time::{Duration, Instant};
    use tauri::Manager;

    // One secret for the life of the app.
    #[cfg_attr(not(ex_tauri_in_process), allow(dead_code))]
    static SECRET_KEY_BASE: OnceLock<String> = OnceLock::new();

    const STARTUP_DEADLINE: Duration = Duration::from_secs(60);

    pub fn run() {
        tauri::Builder::default()
            .setup(|app| {
                let handle = app.handle().clone();
                // Off the main thread: waiting for the backend here would stall
                // the UI run loop and the window would never paint.
                std::thread::spawn(move || {
                    if let Err(error) = boot(&handle) {
                        eprintln!("[ex_tauri] {error}");
                        show_start_failed(&handle, &error);
                    }
                });
                Ok(())
            })
            .run(tauri::generate_context!())
            .expect("error while running tauri application");
    }

    fn boot(app: &tauri::AppHandle) -> Result<(), String> {
        // `mix ex_tauri.ios dev` launches with EX_TAURI_DEV_URL: the simulator
        // shares the Mac's loopback, so the window can use the dev server running
        // there, live reload included, and no backend is started here.
        if let Ok(url) = std::env::var("EX_TAURI_DEV_URL") {
            let port = url.rsplit(':').next().and_then(|p| p.trim_end_matches('/').parse().ok());
            let port = port.ok_or(format!("EX_TAURI_DEV_URL has no port: {url}"))?;
            wait_for(port, &AtomicBool::new(false))?;
            return navigate(app, &url);
        }

        let port = std::net::TcpListener::bind(("127.0.0.1", 0))
            .and_then(|listener| listener.local_addr())
            .map(|addr| addr.port())
            .map_err(|error| format!("no free loopback port: {error}"))?;

        #[cfg(ex_tauri_in_process)]
        return in_process::start(app, port);

        #[cfg(not(ex_tauri_in_process))]
        {
            let _ = port;
            Err("this build has no Erlang runtime linked in: build it with \
                 `mix ex_tauri.ios run` or `mix ex_tauri.ios device`, which stage it"
                .to_string())
        }
    }

    // The BEAM inside the app's own process. ERTS's interpreter, linked in as
    // ordinary signed code, needs neither a child process nor executable memory.
    // It cannot be stopped and started again within one process, so it lives
    // exactly as long as the app: a halt ends the app, and opening it starts a
    // new one.
    #[cfg(ex_tauri_in_process)]
    mod in_process {
        use std::ffi::CString;
        use std::os::raw::{c_char, c_int};
        use std::path::Path;
        use std::sync::atomic::AtomicBool;
        use tauri::Manager;

        extern "C" {
            fn erl_start(argc: c_int, argv: *mut *mut c_char);
        }

        pub fn start(app: &tauri::AppHandle, port: u16) -> Result<(), String> {
            let root = app
                .path()
                .resource_dir()
                .map_err(|e| format!("no resource dir: {e}"))?
                .join("ex_tauri/release");

            let start_erl = std::fs::read_to_string(root.join("releases/start_erl.data"))
                .map_err(|e| format!("the bundled release is missing ({}: {e})", root.display()))?;
            let vsn = start_erl
                .split_whitespace()
                .nth(1)
                .ok_or("releases/start_erl.data names no release version")?
                .to_string();
            let rel_dir = root.join("releases").join(&vsn);
            let name = release_name(&rel_dir)?;

            // The app's sandbox container, for ExTauri.Paths and HOME.
            let home = app.path().home_dir().map_err(|e| format!("no home dir: {e}"))?;
            let tmp = app
                .path()
                .temp_dir()
                .map_err(|e| format!("no temp dir: {e}"))?
                .join("ex_tauri_release");
            std::fs::create_dir_all(&tmp)
                .map_err(|e| format!("could not create {}: {e}", tmp.display()))?;

            // As the release's start script does: runtime.exs is evaluated into a
            // writable copy of sys.config, which -config names without ".config".
            let sys_config = tmp.join("sys.runtime");
            std::fs::copy(rel_dir.join("sys.config"), tmp.join("sys.runtime.config"))
                .map_err(|e| format!("could not stage sys.config: {e}"))?;

            // Name lookups through Erlang's own DNS client: the default asks
            // inet_gethost, a separate program iOS will not start.
            let inetrc = tmp.join("inetrc");
            std::fs::write(
                &inetrc,
                "{edns, 0}.\n{alt_nameserver, {8,8,8,8}}.\n{alt_nameserver, {1,1,1,1}}.\n{lookup, [file, dns]}.\n",
            )
            .map_err(|e| format!("could not write {}: {e}", inetrc.display()))?;

            let path = |p: &Path| p.display().to_string();
            let env = [
                ("RELEASE_ROOT", path(&root)),
                ("RELEASE_NAME", name),
                ("RELEASE_VSN", vsn.clone()),
                ("RELEASE_TMP", path(&tmp)),
                ("RELEASE_SYS_CONFIG", path(&sys_config)),
                ("RELEASE_MODE", "interactive".into()),
                ("HOME", path(&home)),
                // Not used on iOS, but ERTS wants it defined.
                ("BINDIR", path(&root.join("bin"))),
                ("ERL_INETRC", path(&inetrc)),
                ("PORT", port.to_string()),
                ("SECRET_KEY_BASE", super::SECRET_KEY_BASE.get_or_init(super::secret_key_base).clone()),
                ("EX_TAURI_HOME", path(&home)),
                ("EX_TAURI_HOST_OS", "ios".into()),
                // ExTauri.ShutdownManager's :in_process transport, and the bundled
                // CA store ExTauri loads at boot: iOS gives OTP no system store.
                ("EX_TAURI_IN_PROCESS", "1".into()),<%= for {k, v} <- sidecar_env do %>
                ("<%= k %>", "<%= v %>".into()),<% end %>
            ];
            // Before the VM's threads exist: nothing else reads the environment yet.
            for (key, value) in env {
                std::env::set_var(key, value);
            }

            // What the release's start script would hand erl; -MIscs keeps the
            // literal super carrier small, as some iPads cannot reserve the default.
            let args = [
                "beam".to_string(),
                "-sbwt".into(),
                "none".into(),
                "-MIscs".into(),
                "10".into(),
                "--".into(),
                "-root".into(),
                path(&root),
                "-bindir".into(),
                path(&root.join("bin")),
                "-progname".into(),
                "erl".into(),
                "--".into(),
                "-home".into(),
                path(&home),
                "--".into(),
                "-noshell".into(),
                "-start_epmd".into(),
                "false".into(),
                "-elixir".into(),
                "ansi_enabled".into(),
                "false".into(),
                "-s".into(),
                "elixir".into(),
                "start_cli".into(),
                "-mode".into(),
                "interactive".into(),
                "-config".into(),
                path(&sys_config),
                "-boot".into(),
                path(&rel_dir.join("start")),
                "-boot_var".into(),
                "RELEASE_LIB".into(),
                path(&root.join("lib")),
                "--".into(),
                "--".into(),
                "-extra".into(),
                "--no-halt".into(),
            ];

            // ERTS keeps argv for the life of the VM, so it is never freed.
            let argv: Vec<*mut c_char> = args
                .iter()
                .map(|arg| CString::new(arg.as_str()).expect("no NUL in an argument").into_raw())
                .collect();
            let argv: &'static mut [*mut c_char] = Box::leak(argv.into_boxed_slice());
            let argc = argv.len() as c_int;
            let argv = argv.as_mut_ptr() as usize;

            std::thread::Builder::new()
                .name("beam".into())
                .spawn(move || unsafe { erl_start(argc, argv as *mut *mut c_char) })
                .map_err(|e| format!("could not start the BEAM thread: {e}"))?;
            println!("[ex_tauri] BEAM started in-process ({vsn}, port {port})");

            super::wait_for(port, &AtomicBool::new(false))?;
            // The configured host, as on the desktop: PHX_HOST is set from it, and
            // Phoenix refuses a LiveView socket whose origin names another host.
            super::navigate(app, &format!("<%= scheme %>://<%= host %>:{port}/"))
        }

        // The release's name is its .rel file's, beside start.boot.
        fn release_name(rel_dir: &Path) -> Result<String, String> {
            std::fs::read_dir(rel_dir)
                .map_err(|e| format!("could not read {}: {e}", rel_dir.display()))?
                .filter_map(|entry| entry.ok())
                .find_map(|entry| {
                    let path = entry.path();
                    if path.extension()? != "rel" {
                        return None;
                    }
                    Some(path.file_stem()?.to_string_lossy().into_owned())
                })
                .ok_or_else(|| format!("no .rel file in {}", rel_dir.display()))
        }
    }

    // Gives up the moment `exited` says there is nothing left to wait for, rather
    // than at the deadline.
    fn wait_for(port: u16, exited: &AtomicBool) -> Result<(), String> {
        let deadline = Instant::now() + STARTUP_DEADLINE;
        while Instant::now() < deadline {
            if std::net::TcpStream::connect(("<%= host %>", port)).is_ok() {
                return Ok(());
            }
            if exited.load(std::sync::atomic::Ordering::SeqCst) {
                return Err("the backend exited while starting".to_string());
            }
            std::thread::sleep(Duration::from_millis(100));
        }
        Err(format!("nothing answered on <%= host %>:{port} within {}s", STARTUP_DEADLINE.as_secs()))
    }

    fn navigate(app: &tauri::AppHandle, url: &str) -> Result<(), String> {
        let window = app.get_webview_window("main").ok_or("no main window")?;
        let url = url.parse().map_err(|e| format!("bad url {url}: {e}"))?;
        window.navigate(url).map_err(|e| e.to_string())
    }

    // Replaces the window's content when there is no backend to show: a data:
    // page, because the backend is the thing missing. Sized for a phone, and kept
    // clear of the notch and the home indicator.
    fn show_start_failed(app: &tauri::AppHandle, detail: &str) {
        let name = app.package_info().name.clone();
        let title = format!("{name} could not start");
        let lead = "The backend did not come up, so there is nothing to show.";

        // Details are written mid-sentence ("the bundled release is missing ...");
        // here one stands on its own.
        let mut chars = detail.chars();
        let detail = match chars.next() {
            Some(first) => first.to_uppercase().chain(chars).collect::<String>(),
            None => String::new(),
        };

        let html = format!(
            concat!(
                "<!doctype html><meta charset=\"utf-8\">",
                "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">",
                "<title>{title}</title>",
                "<style>",
                ":root {{ color-scheme: light dark; }}",
                "html, body {{ margin: 0; height: 100%; }}",
                "body {{ display: flex; align-items: center; justify-content: center; ",
                "padding: env(safe-area-inset-top) env(safe-area-inset-right) ",
                "env(safe-area-inset-bottom) env(safe-area-inset-left); box-sizing: border-box; ",
                "font: 17px/1.45 -apple-system, system-ui, sans-serif; ",
                "background: Canvas; color: CanvasText; }}",
                ".box {{ max-width: 34rem; padding: 1.5rem; }}",
                "h1 {{ font-size: 1.25rem; margin: 0 0 0.75rem; }}",
                "p {{ margin: 0 0 0.75rem; opacity: 0.85; }}",
                "</style>",
                "<div class=\"box\"><h1>{title}</h1><p>{lead}</p><p>{detail}</p></div>"
            ),
            title = html_escape(&title),
            lead = html_escape(lead),
            detail = html_escape(&detail),
        );

        if let Some(window) = app.get_webview_window("main") {
            if let Ok(url) = data_url(&html).parse() {
                let _ = window.navigate(url);
            }
        }
    }

    fn html_escape(text: &str) -> String {
        text.replace('&', "&amp;")
            .replace('<', "&lt;")
            .replace('>', "&gt;")
            .replace('"', "&quot;")
    }

    fn data_url(html: &str) -> String {
        let mut url = String::from("data:text/html;charset=utf-8,");
        for byte in html.bytes() {
            if byte.is_ascii_alphanumeric() || b"-_.~".contains(&byte) {
                url.push(byte as char);
            } else {
                let _ = write!(url, "%{byte:02X}");
            }
        }
        url
    }

    #[cfg_attr(not(ex_tauri_in_process), allow(dead_code))]
    fn secret_key_base() -> String {
        let mut bytes = [0u8; 48];
        if let Ok(mut urandom) = std::fs::File::open("/dev/urandom") {
            use std::io::Read;
            let _ = urandom.read_exact(&mut bytes);
        }
        let mut out = String::with_capacity(96);
        for byte in bytes {
            let _ = write!(out, "{byte:02x}");
        }
        out
    }
}

#[cfg(mobile)]
#[tauri::mobile_entry_point]
pub fn run() {
    mobile::run()
}
