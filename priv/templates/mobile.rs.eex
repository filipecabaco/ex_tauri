// Generated by `mix ex_tauri.ios init` (ex_tauri:mobile-shell); rerunning it
// regenerates this file. The desktop app starts in main.rs; this is the iOS app.
//
// On iOS there are no sidecars, so this starts the ampoule-packed release that
// `mix ex_tauri.ios build` bundles as a resource, as a child process, and points
// the window at it. That works in the simulator only: a real device forbids
// both starting a process and the executable memory ampoule's engine maps.
#[cfg(mobile)]
mod mobile {
    use std::fmt::Write;
    use std::process::{Child, Command, Stdio};
    use std::sync::Mutex;
    use std::time::{Duration, Instant};
    use tauri::Manager;

    // Held for as long as the app runs: the backend's stdin is the heartbeat.
    // ExTauri.ShutdownManager stops it on EOF, which the kernel delivers however
    // this process ends — a Unix socket path in the app container would be longer
    // than macOS allows.
    struct Backend(Mutex<Option<Child>>);

    pub fn run() {
        tauri::Builder::default()
            .manage(Backend(Mutex::new(None)))
            .setup(|app| {
                let handle = app.handle().clone();
                // Off the main thread: waiting for the backend here would stall
                // the UI run loop and the window would never paint.
                std::thread::spawn(move || {
                    if let Err(error) = boot(&handle) {
                        eprintln!("[ex_tauri] {error}");
                        show_error(&handle, &error);
                    }
                });
                Ok(())
            })
            .run(tauri::generate_context!())
            .expect("error while running tauri application");
    }

    fn boot(app: &tauri::AppHandle) -> Result<(), String> {
        // `mix ex_tauri.ios dev` launches with EX_TAURI_DEV_URL: the simulator
        // shares the Mac's loopback, so the window can use the dev server running
        // there, live reload included, and no backend is started here.
        if let Ok(url) = std::env::var("EX_TAURI_DEV_URL") {
            let port = url.rsplit(':').next().and_then(|p| p.trim_end_matches('/').parse().ok());
            wait_for(port.ok_or(format!("EX_TAURI_DEV_URL has no port: {url}"))?)?;
            return navigate(app, &url);
        }

        if !cfg!(target_abi = "sim") {
            return Err("This build runs its Elixir backend as a separate process, which \
                        iOS only allows in the simulator."
                .to_string());
        }

        let port = std::net::TcpListener::bind(("127.0.0.1", 0))
            .and_then(|listener| listener.local_addr())
            .map(|addr| addr.port())
            .map_err(|error| format!("no free loopback port: {error}"))?;

        let backend = backend_executable(app)?;

        // The app's sandbox container. ampoule shows the backend only what is
        // mounted, and its own HOME is a private /tmp deleted on exit, so the
        // container is mounted at its own path and named for ExTauri.Paths.
        let home = app.path().home_dir().map_err(|e| format!("no home dir: {e}"))?;
        let home = home.display().to_string();

        let mut command = Command::new(&backend);
        command
            .args([
                // Bind nothing but this port, and only on loopback.
                "--listen",
                &port.to_string(),
                "--listen-host",
                "127.0.0.1",
                "--mount",
                &format!("{home}:{home}"),
                "start",
            ])
            .env("PORT", port.to_string())
            .env("SECRET_KEY_BASE", secret_key_base())
            .env("EX_TAURI_HOME", &home)
            .env("EX_TAURI_HOST_OS", "ios")
            .env("EX_TAURI_HEARTBEAT_STDIN", "1")<%= for {k, v} <- sidecar_env do %>
            .env("<%= k %>", "<%= v %>")<% end %>
            .stdin(Stdio::piped());

        let child = command
            .spawn()
            .map_err(|error| format!("the backend could not be started ({error})"))?;
        println!("[ex_tauri] backend started (pid {}, port {port})", child.id());
        *app.state::<Backend>().0.lock().unwrap() = Some(child);

        wait_for(port)?;
        // The configured host, as on the desktop: PHX_HOST is set from it, and
        // Phoenix refuses a LiveView socket whose origin names another host.
        navigate(app, &format!("<%= scheme %>://<%= host %>:{port}/"))
    }

    // Bundled resources lose the executable bit, so the backend runs as a copy in
    // the app's own temporary directory.
    //
    // The copy is written beside it and renamed into place, never written over
    // it: a relaunch starts while the last backend is still shutting down from
    // that file, and a backend started from a binary rewritten under a running
    // one never comes up. The rename leaves the old process its own file.
    fn backend_executable(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String> {
        let resource = app
            .path()
            .resource_dir()
            .map_err(|e| format!("no resource dir: {e}"))?
            .join("ex_tauri/backend");

        let exe = app
            .path()
            .temp_dir()
            .map_err(|e| format!("no temp dir: {e}"))?
            .join("ex_tauri_backend");

        let staged = exe.with_extension(format!("{}.tmp", std::process::id()));

        std::fs::copy(&resource, &staged)
            .map_err(|e| format!("the bundled backend is missing ({}: {e})", resource.display()))?;

        use std::os::unix::fs::PermissionsExt;
        std::fs::set_permissions(&staged, std::fs::Permissions::from_mode(0o755))
            .map_err(|e| format!("could not make the backend executable: {e}"))?;

        std::fs::rename(&staged, &exe)
            .map_err(|e| format!("could not put the backend in place: {e}"))?;

        Ok(exe)
    }

    fn wait_for(port: u16) -> Result<(), String> {
        let deadline = Instant::now() + Duration::from_secs(60);
        while Instant::now() < deadline {
            if std::net::TcpStream::connect(("<%= host %>", port)).is_ok() {
                return Ok(());
            }
            std::thread::sleep(Duration::from_millis(100));
        }
        Err(format!("nothing answered on <%= host %>:{port} within 60s"))
    }

    fn navigate(app: &tauri::AppHandle, url: &str) -> Result<(), String> {
        let window = app.get_webview_window("main").ok_or("no main window")?;
        let url = url.parse().map_err(|e| format!("bad url {url}: {e}"))?;
        window.navigate(url).map_err(|e| e.to_string())
    }

    fn show_error(app: &tauri::AppHandle, message: &str) {
        if let Some(window) = app.get_webview_window("main") {
            let text = serde_json::to_string(message).unwrap_or_default();
            let _ = window.eval(&format!(
                "document.body.innerHTML = '<p style=\"font:16px -apple-system,sans-serif;padding:2rem\"></p>';\
                 document.body.firstChild.textContent = {text};"
            ));
        }
    }

    // Signs session cookies for this launch only: sessions reset between
    // launches, which is fine for a local app.
    fn secret_key_base() -> String {
        let mut bytes = [0u8; 48];
        if let Ok(mut urandom) = std::fs::File::open("/dev/urandom") {
            use std::io::Read;
            let _ = urandom.read_exact(&mut bytes);
        }
        let mut out = String::with_capacity(96);
        for byte in bytes {
            let _ = write!(out, "{byte:02x}");
        }
        out
    }
}

#[cfg(mobile)]
#[tauri::mobile_entry_point]
pub fn run() {
    mobile::run()
}
